{
  "outputDirectory": "site",
  "buildCommand": "",
  "installCommand": "",
  "framework": null,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/wp-content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wp-includes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/homes-for-heroes-a-program-that-benefits-homebuyers-with-discounts-and-savings/",
      "destination": "/home-loans-for-first-responders/",
      "permanent": true
    }
  ]
}